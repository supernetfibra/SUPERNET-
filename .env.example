[TEMPLATE]
# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase (service role key — never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MikWeb API Integration
# The base URL of your MikWeb instance API
MIKWEB_API_URL=https://seu-mikweb.com.br/api
# Bearer token for MikWeb API authentication
MIKWEB_API_TOKEN=seu-token-aqui

# Admin password for the admin panel
MIKWEB_ADMIN_PASSWORD=sua-senha-admin

# VAPID keys for Web Push notifications
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@portalcliente.com.br

# Development (optional — for local Hono dev server)
API_DEV_URL=http://localhost:3001
