# Supabase (frontend — the Vercel↔Supabase integration sets these automatically)
#
# Project ref: ssvwlbwsprjpfmevdnvb
# URL real do projeto: https://ssvwlbwsprjpfmevdnvb.supabase.co
#
# Esse arquivo é template. Em dev/local você pode copiar para .env.local,
# mas em produção os valores reais geralmente já vêm da integração Vercel↔Supabase.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional override for the API base URL (defaults to <VITE_SUPABASE_URL>/functions/v1)
# VITE_API_URL=http://localhost:54321/functions/v1

# Backend secrets — set with: supabase secrets set KEY=value
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically)
MIKWEB_API_URL=https://seu-mikweb.com.br/api
MIKWEB_API_TOKEN=seu-token-aqui
MIKWEB_ADMIN_PASSWORD=sua-senha-admin

# VAPID keys for Web Push notifications (backend secrets)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@portalcliente.com.br

# WhatsApp (UazAPI) — lembretes de fatura
#
# Os secrets daqui têm PRIORIDADE sobre o que for salvo no painel admin
# (aba Configurações → Lembretes por WhatsApp). Sem eles, valem os valores
# salvos na tabela whatsapp_config.
#
# UAZAPI_BASE_URL          → Server URL da sua instância (ex.: https://xxx.uazapi.com)
# UAZAPI_INSTANCE_TOKEN    → token da instância (header `token`): envia mensagem e lê status
# UAZAPI_ADMIN_TOKEN       → admintoken (header `admintoken`): criar/listar instância
UAZAPI_BASE_URL=
UAZAPI_INSTANCE_TOKEN=
UAZAPI_ADMIN_TOKEN=

# Secret que valida o webhook da UazAPI (POST /api/webhooks/uazapi).
# Sem ele o webhook aceita qualquer origem — e registra um aviso no log.
UAZAPI_WEBHOOK_SECRET=

# Secret que autoriza os endpoints internos de cron (POST /api/cron/notify-dispatch).
CRON_SECRET=
